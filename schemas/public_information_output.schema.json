{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicInformationOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "output_purpose", "boundaries", "recognition_context", "information_items"],
  "properties": {
    "scenario_id": {"enum": ["corresponding_basis", "changed_correspondence"]},
    "output_purpose": {"const": "bounded_correspondence_recognition_information"},
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["informational_only", "qualification_authority", "execution_authority"],
      "properties": {"informational_only": {"const": true}, "qualification_authority": {"const": false}, "execution_authority": {"const": false}}
    },
    "recognition_context": {
      "type": "object", "additionalProperties": false,
      "required": ["context_id", "recognition_result_count", "recognition_result_refs", "bounded_correspondence_states"],
      "properties": {
        "context_id": {"type": "string", "pattern": "^ctx-[a-f0-9]{16}$"},
        "recognition_result_count": {"type": "integer", "minimum": 1},
        "recognition_result_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "bounded_correspondence_states": {"type": "array", "minItems": 1, "items": {"enum": ["BASIS_CORRESPONDS", "CHANGED_CORRESPONDENCE"]}}
      }
    },
    "information_items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "kind", "recognition_result_ref", "state", "source_fact_refs", "relationship_profile_id", "relationship_profile_version", "rule_id", "rule_version"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "kind": {"const": "bounded_correspondence_recognition"},
          "recognition_result_ref": {"type": "string", "minLength": 1},
          "state": {"enum": ["BASIS_CORRESPONDS", "CHANGED_CORRESPONDENCE"]},
          "source_fact_refs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "relationship_profile_id": {"type": "string", "minLength": 1},
          "relationship_profile_version": {"type": "string", "minLength": 1},
          "rule_id": {"type": "string", "minLength": 1},
          "rule_version": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
